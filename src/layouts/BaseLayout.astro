---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/kalam/300.css';
import '@fontsource/kalam/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/sketch.css';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = `${profile.name}, DevOps and Cloud Engineer`,
  description = profile.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og.png'), Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'DevOps / Cloud Engineer',
  email: `mailto:${profile.email}`,
  url: canonical.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Nablus', addressCountry: 'PS' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'An-Najah National University' },
  sameAs: [profile.links.github, profile.links.linkedin],
  knowsAbout: ['Kubernetes', 'GitOps', 'Argo CD', 'Terraform', 'Microsoft Azure', 'Amazon Web Services', 'Cilium', 'eBPF', 'Linux networking'],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
    <meta name="theme-color" content="#0e1830" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sami Hajji, DevOps / Cloud Engineer, written on an engineering computation pad beside a sketch of a pair of eyes peering over a Kubernetes node." />
    <meta property="profile:first_name" content="Sami" />
    <meta property="profile:last_name" content="Hajji" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Before first paint: apply the saved theme (dark by default) and enable
      // motion-dependent styles, so there is no flash of the wrong theme.
      (function () {
        var d = document.documentElement;
        var t = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') t = saved;
        } catch (e) {}
        d.dataset.theme = t;
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
