---
import Sheet from '../sheet/Sheet.astro';
import { log, training, languages } from '../../data/experience';

interface Props {
  number: number;
  total: number;
}
const { number, total } = Astro.props;
---
<Sheet
  id="log"
  number={number}
  total={total}
  subject="Experience and education"
  fields={[{ label: 'Entries', value: `${log.length} entries, ${training.length} courses` }]}
  title="Logbook"
>
  <ol class="log">
    {log.map((e) => (
      <li class="log__entry" id={e.id}>
        <div class="log__when">
          <p class="log__period">{e.period}</p>
          <p class="label">{e.kind}{e.place ? `, ${e.place}` : ''}</p>
        </div>
        <div class="log__what">
          <h3>{e.title}</h3>
          <p class="log__org">{e.org}</p>
          <p class="log__summary">{e.summary}</p>
          <ul class="log__points">
            {e.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  <section class="training" aria-labelledby="training-title">
    <h3 id="training-title">Courses and certification preparation</h3>
    <ul>
      {training.map((t) => (
        <li>
          <span class="training__title">{t.title}</span>
          <span class="label">{t.org}, {t.period}</span>
          {t.note && <span class="training__note">{t.note}</span>}
        </li>
      ))}
    </ul>
    <p class="training__langs"><span class="label">Languages</span> {languages}</p>
  </section>
</Sheet>

<style>
  .log {
    list-style: none;
    display: grid;
    gap: var(--s-7);
  }

  .log__entry {
    display: grid;
    grid-template-columns: minmax(9rem, 13rem) minmax(0, 1fr);
    gap: var(--s-3) var(--s-6);
    scroll-margin-top: var(--s-6);
  }

  .log__period {
    font-family: var(--font-hand);
    font-weight: 400;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .log__org {
    margin-top: var(--s-1);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--ink);
  }

  .log__summary {
    margin-top: var(--s-3);
    max-width: var(--measure);
  }

  .log__points {
    list-style: none;
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-4);
    max-width: var(--measure);
    font-size: var(--fs-sm);
  }

  .log__points li {
    position: relative;
    padding-left: 1.2rem;
  }

  .log__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.6rem;
    border-top: 1.5px solid var(--ink);
    transform: rotate(-4deg);
  }

  .training {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px dashed var(--rule);
    max-width: 52rem;
  }

  .training h3 {
    font-size: var(--fs-md);
  }

  .training ul {
    list-style: none;
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .training li {
    display: grid;
    gap: 0.05rem;
  }

  .training__title {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .training__note {
    font-size: var(--fs-sm);
    max-width: 46em;
  }

  .training__langs {
    margin-top: var(--s-5);
    font-size: var(--fs-sm);
  }

  .training__langs .label {
    margin-right: 0.4em;
  }

  @media (max-width: 47.99rem) {
    .log__entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
