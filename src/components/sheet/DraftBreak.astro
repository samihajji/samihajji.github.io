---
/**
 * Divider between projects: the draftsman's break line, the symbol a
 * technical drawing uses to say "the part continues, but we've cut it here".
 * Labelled with the next project's position in the sequence.
 */
import { line } from '../../lib/sketch';

interface Props {
  label: string;
  seed?: number;
}
const { label, seed = 1 } = Astro.props;
const left = line([2, 13], [132, 13], seed, { bow: 1.2 });
const zig = `M132 13 L139 3.5 L151 22.5 L158 13`;
const right = line([158, 13], [300, 13], seed + 3, { bow: 1.2 });
---
<div class="draft-break" aria-hidden="true">
  <svg viewBox="0 0 302 26" focusable="false">
    <path d={left} />
    <path d={zig} />
    <path d={right} />
  </svg>
  <span class="hand">{label}</span>
</div>

<style>
  .draft-break {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block: var(--s-2) 0;
  }

  .draft-break svg {
    width: min(19rem, 60%);
    height: auto;
    overflow: visible;
  }

  .draft-break path {
    fill: none;
    stroke: var(--pencil);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .draft-break .hand {
    font-size: 1.05rem;
    color: var(--pencil);
    white-space: nowrap;
  }
</style>
