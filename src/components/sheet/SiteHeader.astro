---
import { profile } from '../../data/profile';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  sheets: { id: string; label: string }[];
}
const { sheets } = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="#top">{profile.name}</a>
    <nav class="site-nav" aria-label="Sheets">
      <ol>
        {sheets.map((s, i) => (
          <li>
            <a href={`#${s.id}`}><span class="n" aria-hidden="true">{i + 2}</span>{s.label}</a>
          </li>
        ))}
      </ol>
    </nav>
    <ThemeToggle />
  </div>
</header>
